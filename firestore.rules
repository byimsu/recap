rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------
    // users/{uid}  — profile, dailyStudyMinutes, etc.
    // -------------------------------------------------------
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // deadlines subcollection
      match /deadlines/{deadlineId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // text notes subcollection
      match /textNotes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // decks subcollection
      match /decks/{deckId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        // cards nested under each deck
        match /cards/{cardId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }
    }
  }
}
